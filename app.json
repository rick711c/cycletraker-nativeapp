{
  "expo": {
    "name": "Flora",
    "slug": "flora",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "flora",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "app.stewbit.flora",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "app.stewbit.flora",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-splash-screen",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a40f8e36-e266-4ff4-83bb-99d1756e2411"
      }
    }
  }
}
